#!/bin/bash
#MSUB -N ghost_burg_bench_cpu
#MSUB -W group_list=hpc2-cnsm-psun-users
#MSUB -l nodes=1:ppn=1
#MSUB -l walltime=00:01:00:00
# CPU benchmark: 2000 optimizer steps with only start/end evaluation.
set -eu
BASE="${HPC_BASE:-/home/032480329/hpc_pde_smooth_noise/20261028}"
SRC="${SRC:-$BASE/src}"
BENCH="${BENCH:-$BASE/bench}"
PY="${PY:-/home/032480329/mambaforge/envs/pdenet/bin/python}"
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export PYTHONDONTWRITEBYTECODE=1
cd "$SRC"
echo "bench_cpu_start_utc=$(date -u +%FT%TZ) host=$(hostname)"
"$PY" -u runs/run_burgers_smooth_noise_sampling.py \
  --mode benchmark --output "$BENCH/cpu" --ratio 1.0 --sigma 0 --seed 0 \
  --steps "${STEPS:-2000}" --device cpu
echo "bench_cpu_end_utc=$(date -u +%FT%TZ) exit=0"
